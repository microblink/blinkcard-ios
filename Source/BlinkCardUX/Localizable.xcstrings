      }
    },
    "mb_blinkcard_flashlight_warning_message": {
      "comment": "scan.error.flashlight.card: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ sɛ wobehu flashlight hann bi a.\nNkakrankakra no fa wo kaad no kyinkyin na antɔ so."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የባትሪ ብርሃን እንዳያበራ ይጠንቀቁ።\nካርድዎን ለማስቀረት በቀስታ ያንቀሳቅሱት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذر وهج المصباح الضوئي.\nحرِّك بطاقتك حوله برفق لتفاديه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্ল্যাশলাইটের ঝলকানি থেকে সতর্ক থাকুন।\nএটি এড়াতে আপনার আইডিটি আলতো করে ঘোরান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte pozor na odlesky způsobené bleskem.\nVyhnete se jim lehkým pohybem karty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold øje med lygtens genskin.\nFlyt dit jirt forsigtigt rundt for at undgå det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie auf die Blendung durch eine Taschenlampe.\nBewegen Sie Ihre Karte vorsichtig umher, um dies zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσέξτε την αντανάκλαση από τον φακό.\nΚουνήστε απαλά την πιστωτική σας κάρτα για να την αποφύγετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out for flashlight glare.\nGently move your card around to avoid it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out for flashlight glare.\nGently move your card around to avoid it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenga cuidado con el resplandor de la linterna.\nMueva suavemente su tarjeta alrededor para evitarla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenga cuidado con el resplandor de la linterna.\nMueva suavemente su tarjeta para evitarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مراقب تابش خیره کننده چراغ قوه باشید.\nکارت خود را به آرامی حرکت دهید تا از آن جلوگیری شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varo salaman häikäisyä.\nSiirrä korttiasi varovasti välttääksesi häikäisyn."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan kung may flashlight glare.\nDahan-dahang galawin ang iyong card para maiwasan ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention aux reflets de la lampe de poche.\nBougez doucement votre carte pour les éviter."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites attention à l'éblouissement causé par le flash.\nVeuillez déplacer délicatement votre carte pour l'éviter."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A duba idan akwai wurin da haske ya dusashe takardar.\nMatsar da katin ku a hankali don guje masa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היזהרו מפני סנוור הפנס.\nהזיזו בעדינות את הכרטיס שלכם בכדי להימנע מהדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टॉर्च की चकाचौंध से सावधान रहें।\nइससे बचने के लिए अपने कार्ड को धीरे से इधर-उधर घुमाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smanjite odsjaj bljeskalice laganim pomicanjem kartice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyeljen oda a vaku fényének visszaverődésére.\nFinoman mozgassa a kártyáját, hogy elkerülje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awas lampu kilat silau.\nGerakkan kartu Anda dengan perlahan untuk menghindarinya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gætið að glampi frá vasaljósum.\nFærðu kortið varlega til að forðast það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione al riflesso della luce.\nMuovi lentamente la carta per evitarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "懐中電灯のまぶしさに注意してください。\nそれを避けるためにカードをゆっくり動かしてください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "მოერიდეთ ბლიცის მკვეთრ ნათებას.\nამის თავიდან ასაცილებლად, ფრთხილად გადაადგილეთ საკრედიტო ბარათი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фонарьдың жарқылына назар аударыңыз.\nОдан құтылу үшін картаңызды ақырын жылжытыңыз."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រយ័ត្នចំពោះពន្លឺពិលភ្លឺចែងចាំង។\nរំកិលកាតរបស់អ្នកថ្នមៗដើម្បីជៀសវាងវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손전등 불빛에 주의하세요.\n카드를 살살 움직여서 부딪히지 않도록 하세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzmanieties no lukturīša atspīduma.\nViegli pārvietojiet karti, lai no tās izvairītos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhati-hati dengan silau lampu suluh.\nGerakkan kad anda dengan perlahan di sekeliling untuk menjauhinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass deg for gjenskinn fra sterkt lys.\nFlytt kortet forsiktig rundt for å unngå det."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्चलाइटको चमकबाट सावधान रहनुहोस्।\nयसबाट बच्नको लागि आफ्नो कार्डलाई बिस्तारै घुमाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas op voor schittering van de flitser.\nVerplaats uw kaart voorzichtig om dit te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwróć uwagę na odblaski od flesza.\nDelikatnie zmień pozycję kartą, aby ich uniknąć."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "د فلش لائټ ځلا ته پام وکړئ.\nد مخنیوي لپاره خپل کارت په نرمۍ سره شاوخوا وګرځئ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha cuidado com o clarão da lanterna.\nMova de forma ligeira o seu cartão para o evitar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidado com o brilho da lanterna.\nMova o cartão delicadamente para evitar isso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiți atent la strălucirea cauzată de lumina blițului.\nMutați-vă ușor cardul pentru a o evita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остерегайтесь бликов от фонарика.\nАккуратно перемещайте карту, чтобы избежать столкновения."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ෆ්ලෑෂ් ලයිට් දිලිසීම ගැන විමසිල්ලෙන් සිටින්න.\nඑය වළක්වා ගැනීම සඳහා ඔබේ කාඩ්පත මෘදු ලෙස එහා මෙහා කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozor na oslnenie bleskom.\nJemne pohnite kartou, aby ste tomu zabránili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazite na bleščanje bliskavice.\nKartico rahlo premaknite, da se mu izognete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazite na odsjaj blica.\nNežno pomerajte svoju karticu da biste ga izbegli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Akta dig för reflektioner från kamerablixten.\nFlytta försiktigt på kortet för att undvika det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jihadhari na mwangaza wa tochi.\nSogeza kadi yako kwa upole ili kuiepuka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระวังแสงจ้าจากไฟฉาย ค่อย ๆ ขยับบัตรไปเพื่อหลีกเลี่ยง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El fenerinin parlamasına dikkat edin.\nKartınızı hafifçe hareket ettirerek çarpmayı önleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверніть увагу на відблиски ліхтарика.\nОбережно рухайте карткою, щоб уникнути цього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹارچ کی چکاچوند پر نگاہ رکھیں۔\nاس سے بچنے کے لیے اپنے کارڈ کو آہستہ سے ادھر ادھر گھمائیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiroqning porlashiga e'tibor bering.\nBunga yo'l qo'ymaslik uchun kartangizni muloyimlik bilan harakatlantiring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề phòng ánh sáng của đèn flash.\nNhẹ nhàng di chuyển thẻ của bạn xung quanh để tránh nó."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ṣọ́ra fún ìmọ́lẹ̀ iná mànàmáná.\nFi pẹ̀lẹ́pẹ̀lẹ́ gbé káàdì rẹ káàkiri kí o má baà ṣe é."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当心闪光灯眩光。\n请轻轻移动您的身份证件，避免产生眩光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請注意閃光燈眩光。\n慢慢移動您的銀行卡以避免眩光。"
          }
        }
      }
    },
    "mb_blinkcard_help_screen_msg1": {
      "comment": "scan.help.number.card.message: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Mpɛn pii no, kaade nɔma no taa yɛ digit 16, ɛwom sɛ ebetumi ayɛ efi digit 12 kosi 19 de. Etumi yɛ nea wɔaprinte agu so anaa wɔakurukyerɛw agu so ma aba soro, na ebetumi awɔ anim anaa kaade no akyi."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የካርድ ቁጥሩ ብዙውን ጊዜ ባለ 16 አሃዝ ቁጥር ነው፣ ቢሆንም ከ12 እስከ 19 አሃዞች ሊኖረው ይችላል። በካርዱ ላይ በተነሱ ቁጥሮች መታተም ወይም መቀረጽ አለበት። በካርድዎ ፊት ወይም ጀርባ ላይ ሊሆን ይችላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتكون رقم البطاقة عادةً من 16 رقماً، على الرغم من أنه قد يتراوح بين 12 و 19 رقماً. يجب أن تكون مطبوعة أو منقوشة بأرقام بارزة في البطاقة. يمكن أن تكون موجودة في وجه البطاقة أو ظهرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড নম্বর সাধারণত 16 সংখ্যার হয়, তবে এটি 12 থেকে 19 সংখ্যারও হতে পারে। এটি কার্ডের উপর উঁচু অক্ষরে খোদাই করা বা ছাপানো থাকে। এটি কার্ডের সামনে বা পিছনে থাকতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo karty je obvykle 16místné, může však mít 12 až 19 číslic. Mělo by být buď vytištěno, nebo vyraženo reliéfními číslicemi podél karty. Může být na přední nebo zadní straně karty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortnummeret er normalt et 16-cifret nummer, selvom det kan have mellem 12 og 19 cifre. Det skal enten være trykt eller præget med hævede tal på tværs af kortet. Det kan være på forsiden eller bagsiden af dit kort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartennummer besteht normalerweise aus 16 Ziffern, kann aber auch zwischen 12 und 19 Ziffern umfassen. Die Nummer sollte entweder aufgedruckt oder in erhabenen Ziffern auf der Karte eingeprägt sein. Sie kann sich auf der Vorder- oder Rückseite Ihrer Karte befinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός της κάρτας είναι συνήθως 16ψήφιος, παρότι ενδέχεται να περιλαμβάνει από 12 έως 19 ψηφία. Θα αναγράφεται ή θα είναι χαραγμένος με ανάγλυφους αριθμούς πάνω στην κάρτα. Μπορεί να αναγράφεται στην μπροστινή ή την πίσω όψη της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card number is usually a 16-digit number, although it may have between 12 and 19 digits. It should be either printed or embossed in raised numbers across the card. It can be on the front or back of your card."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The card number is usually 16 digits long, though it may be between 12 and 19 digits. It will be printed or embossed in raised numbers on the card, either on the front or the back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de la tarjeta suele tener 16 dígitos, aunque puede tener entre 12 y 19 dígitos. Debe estar impreso o grabado en relieve a lo largo de la tarjeta. Puede estar en el anverso o en el reverso de la tarjeta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de la tarjeta suele ser un número de 16 dígitos, aunque puede tener entre 12 y 19 dígitos. Debe estar impreso o grabado en relieve en la tarjeta. Puede estar en el anverso o en el reverso de la tarjeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شماره کارت معمولاً یک عدد ۱۶ رقمی است، اگرچه ممکن است بین ۱۲ تا ۱۹ رقم داشته باشد. این شماره باید یا چاپ شده باشد یا به صورت اعداد برجسته در سراسر کارت حک شده باشد. می‌تواند در جلو یا پشت کارت شما باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin numero sisältää tavallisesti 16 numeroa, mutta se voi myös olla 12–19 numeroa pitkä. Numeron tulisi olla painettuna tai kohokuvioituna kortin etu- tai kääntöpuolelle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadalasang 16 na digit ang numero ng card, bagama't maaari itong magkaroon ng 12 hanggang 19 digit. Dapat itong naka-print o naka-emboss sa mga nakataas na numero sa buong card. Puwede itong nasa unahan o likuran ng iyong card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro de carte est généralement un numéro à 16 chiffres, même s'il peut comporter entre 12 et 19 chiffres. En général, il est imprimé ou gravé en relief sur toute la surface de la carte. Il peut figurer au recto ou au verso de votre carte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro de carte est généralement composé de 16 chiffres, mais il peut en comporter entre 12 et 19. Il doit être imprimé ou gravé en relief sur la carte. Il peut se trouver au recto ou au verso de votre carte."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yawanci lambar kati takan kasance lambobi 16, duk da cewa za ta iya ƙunsar lambobi tsakanin 12 zuwa 19. Za su kasance ko dai waɗanda aka gurza da rubutun kwamfuta ko waɗanda aka zana da tsarin rubutu mai tudu a kan katin. Zai iya kasance a gaba ko a bayan katinku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר הכרטיס הוא בדרך כלל באורך 16 ספרות, אם כי הוא יכול להיות באורך של בין 12 ל-19 ספרות. זה צריך להיות מודפס או מוטבע עם מספרים בולטים על פני הכרטיס. זה יכול להיות בחלק הקדמי או האחורי של הכרטיס שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड नंबर आमतौर पर 16 अंकों का होता है, हालाँकि इसमें 12 से 19 अंक भी हो सकते हैं. इसे कार्ड पर उभरे हुए अंकों में या तो प्रिंट किया होना चाहिए या फिर उभरा हुआ होना चाहिए. यह आपके कार्ड के आगे या पीछे हो सकता है."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj kartice obično se sastoji od 16 znamenki, iako ih može imati između 12 i 19. Broj je otisnut ili urezan reljefnim brojkama na kartici i može se nalaziti na prednjoj ili stražnjoj strani kartice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyaszám általában 16 számjegyből áll, ugyanakkor 12–19 számjegyből álló kártyaszám is előfordul. A szám nyomtatva vagy kiemelkedő, dombornyomott formában látható a kártyán. A kártya elülső vagy hátsó oldalán található."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor kartu biasanya berupa angka 16 digit, meski mungkin antara 12 dan 19 digit. Nomor itu mestinya dicetak atau diembos dengan angka timbul di kartu. Pastikan kartu cukup terang dan semua detail terlihat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortanúmer er venjulega 16 stafa númer, þó það geti verið á bilinu 12 til 19 stafir. Það ætti að vera annaðhvort prentað eða upphleypt með upphleyptum tölum á kortinu. Það getur verið á framhlið eða bakhlið kortsins þíns."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero della carta è in genere un numero di 16 cifre, ma potrebbe contenere da 12 a 19 cifre. Dovrebbe essere stampato o impresso in rilievo sulla carta. Potrebbe essere sul fronte o sul retro della carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード番号は通常,16桁の数字ですが,12～19桁の場合もあります。カード番号は,カードに印刷またはエンボス加工（浮き彫り）された数字として記載されています。カードの表面または裏面に記載されています。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარათის ნომერი, როგორც წესი, 16 ციფრისგან შედგება, თუმცა მასში შეიძლება იყოს 12-დან 19 ციფრამდე. ეს ნომერი ან დაბეჭდილი უნდა იყოს, ან ამოტვიფრული ამობურცული ციფრებით ბარათზე. ის შეიძლება თქვენი ბარათის წინა ან უკანა მხარეს იყოს დატანილი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта нөмірі әдетте 16 таңбалы саннан тұрады және сондай-ақ 12 мен 19 сан аралығында болуы мүмкін. Ол басып шығарылуы немесе карта бойынша жоғары сандармен бедерлі болуы керек. Ол картаның алдыңғы немесе артында болуы мүмкін."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "លេខកាតជាធម្មតាជាលេខ 16 ខ្ទង់ ទោះបីជាវាអាចមានចន្លោះពី 12 ទៅ 19 ខ្ទង់ក៏ដោយ។ វាគួរតែត្រូវបានបោះពុម្ព ឬក្រឡោតជាលេខដែលបានលើកឡើងនៅទូទាំងកាត។ វាអាចនៅខាងមុខ ឬខាងក្រោយកាតរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 번호는 일반적으로 16자리 숫자이지만, 12자리에서 19자리 사이일 수도 있습니다. 카드에 인쇄되어 있거나, 양각으로 돌출된 숫자로 표시되어 있습니다. 카드의 앞면 또는 뒷면에 있을 수 있습니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parasti kartes numuru veido 16 cipari, bet tas var būt arī 12–19 ciparus garš. Tam jābūt uzdrukātam vai reljefi iespiestam pār karti. Kartes numurs var būt gan tās priekšpusē, gan aizmugurē."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor kad biasanya mempunyai nombor 16 digit, walaupun ia mungkin mempunyai nombor antara 12 hingga 19 digit. Ia hendaklah sama ada dicetak atau dicetak timbul dengan nombor berganda di sepanjang kad. Nombor tersebut boleh berada di bahagian hadapan atau belakang kad anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortnummeret er vanligvis et nummer på 16 siffer, men det kan bestå av 12 til 19 siffer. Det skal enten være trykt eller preget i opphøyde tall på kortet, og det kan stå på forsiden eller baksiden."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड नम्बर सामान्यतया 16 अंकको भए पनि, यो 12 देखि 19 अंकको बीचमा पनि हुन सक्छ। यो नम्बर कार्डमा माथि उठेका अक्षरमा इम्बोस्ड गरिएको वा छापिएको हुन्छ र कार्डको अगाडि वा पछाडि जुनसुकै भागमा हुन सक्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kaartnummer bestaat in de regel uit 16 cijfers, maar kan ook uit 12 tot 19 cijfers bestaan. Het nummer is ofwel gedrukt of in reliëf in verhoogde cijfers op de kaart aangebracht. Het nummer kan op de voor- of achterkant van uw kaart staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numer karty jest zwykle numerem 16-cyfrowym, chociaż może mieć od 12 do 19 cyfr. Powinien być wydrukowany lub wytłoczony wypukłymi cyframi na karcie. Może znajdować się na awersie lub odwrocie karty."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "د کارت شمېره معموله 16 عدده وي، مګر کېدای شي ځینې یې له 12 تر 19 پورې ارقام ولري. دا شمېره باید په چاپي یا برجسته ډول پر کارت لیکل شوې وي. دا کېدای شي ستاسو د کارت په مخه یا شا کې وي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O número do cartão geralmente é um número de 16 dígitos, embora possa ter entre 12 e 19 dígitos. Deverá estar impresso ou gravado com relevo no cartão. Poderá também estar na frente ou no verso do seu cartão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número do cartão geralmente tem 16 dígitos, embora possa ter entre 12 e 19 dígitos. Ele deve estar impresso ou gravado em alto relevo em todo o cartão. Pode estar na frente ou no verso do seu cartão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul cardului conține de regulă 16 cifre, deși unele pot avea între 12 și 19 cifre. În principiu, acesta este inscripționat sau reliefat pe card. Se poate afla pe partea din față sau partea verso a cardului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер карты обычно состоит из 16 цифр, хотя может содержать от 12 до 19 цифр. Он должен быть напечатан или выбит рельефными цифрами по всей карте. Он может быть на лицевой или оборотной стороне карты."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කාඩ්පත් අංකය සාමාන්‍යයෙන් ඉලක්කම් 16කින් යුත් අංකයක් වන නමුත් එහි ඉලක්කම් 12ත් 19ත් අතර ප්‍රමාණයක් තිබිය හැක. එය කාඩ්පත මත මුද්‍රණය කර ඇති හෝ පිටතට නෙරා ගිය ලෙස කැටයම් කළ අංකයකි. එය ඔබේ කාඩ්පතේ ඉදිරිපස හෝ පිටුපස තිබිය හැකි ය."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo karty je zvyčajne 16-miestne číslo, hoci môže mať 12 až 19 číslic. Malo by byť vytlačené alebo vyrazené vo forme vyvýšených čísel naprieč kartou. Môže byť na prednej alebo zadnej strane karty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Številka kartice je običajno 16-mestna, vendar je lahko sestavljena iz 12 do 19 številk. Natisnjena ali vtisnjena mora biti z dvignjenimi številkami na celotni kartici. Lahko je na sprednji ali zadnji strani kartice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj kartice je obično 16-cifreni broj, iako može imati između 12 i 19 cifara. Trebalo bi da bude odštampan ili utisnut podignutim brojevima preko kartice. Može biti na prednjoj ili zadnjoj strani kartice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortnumret består oftast av 16 siffror, men det kan bestå av mellan 12 och 19 siffror. Numret är antingen tryckt eller präglat i upphöjda siffror på kortets fram- eller baksida."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Namba ya kadi kawaida ni namba 16, ingawa inaweza kuwa na kati ya namba 12 na 19. Inapaswa kuwa imechapishwa au kuchorwa kwa namba zilizoinuka kwenye kadi. Inaweza kuwa mbele au nyuma ya kadi yako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขบัตรมักจะเป็นตัวเลข 16 หลัก แต่อาจยาวระหว่าง 12 ถึง 19 หลักได้ และเป็นตัวเลขพิมพ์หรือปั๊มนูนพาดอยู่บนบัตร โดยอาจอยู่หน้าหรือหลังบัตรก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart numarası, genellikle 16 haneli, ancak kimi zaman 12 ila 19 haneli de olabilen bir sayıdır. Kartın üzerinde kabartmalı rakamlarla basılı veya kabartmalı olmalıdır. Kartınızın ön veya arka yüzünde bulunabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер картки зазвичай складається з 16 цифр, хоча може мати від 12 до 19 цифр. Він має бути надрукований або вибитий у вигляді рельєфних цифр по всій картці. Він може бути на лицьовій або зворотній стороні картки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ نمبر عموماً 16 ہندسوں پر مشتمل ہوتا ہے، لیکن یہ 12 سے 19 ہندسوں کے درمیان بھی ہو سکتا ہے۔ یہ نمبر یا تو پرنٹ کیا ہوا ہوتا ہے یا ابھری ہوئی شکل میں کارڈ پر موجود ہوتا ہے۔ یہ آپ کے کارڈ کے سامنے یا پچھلے حصے پر ہو سکتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta raqami odatda 16 ta raqamdan iborat, ammo 12–19 ta raqamli boʻlishi ham mumkin. U kartada bosma yoki boʻrtma shaklda tushirilgan boʻlishi kerak. U kartaning old yoki orqa tomonida joylashgan boʻlishi mumkin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số thẻ thường là số có 16 chữ số, mặc dù có thể có từ 12 đến 19 chữ số. Các số đó phải được in hoặc dập nổi trên thẻ. Số này có thể ở mặt trước hoặc mặt sau của thẻ."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Nọ́mbà káàdì sábà máa ń jẹ́ dígítì 16, bíótilẹ̀ jẹ́ pé ó lè ní láàárín àwọn dígítì 12 àti 19. Ó gbọdọ̀ wà ní àtẹ̀jáde tàbí kí wọ́n fín ní gbọọrọ sórí káàdì náà ní àwọn nọ́mbà tí ọwọ́ lè rí. Ó lè wà ní iwájú tàbí ẹ̀yìn káàdì náà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡号通常是 16 位数，不过也可能是 12 到 19 位数。卡号应该是卡中打印或凸印的数字。可能位于卡的正面或背面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡號通常是 16 位數字，也可能是 12 到 19 位數字。應該在卡片上以凸起數字印刷或雕刻。數字可能在卡面的正面或背面。"
          }
        }
      }
    },
    "mb_blinkcard_help_screen_msg2": {
      "comment": "scan.help.visibility.card.message: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ sɛ wommfa wo nsateaa nkata kaade no fa biara, a ase hɔ ka ho. Bio nso, hwɛ sɛ hologram no remmɔ kanea nngu kaade no so nsɛm bi so."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የታችኛውን መስመሮች ጨምሮ የካርዱን ክፍሎች በጣት አለመሸፈንዎን ያረጋግጡ። እንዲሁም በካርዶች መስኮች ላይ የሚሄዱ የሆሎግራም ነጸብራቆችን ይመልከቱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أنك لا تغطي أي جزء من البطاقة بإصبعك، بما في ذلك الخطوط السفلية. واحترس أيضاً من انعكاسات الهولوغرام التي تمر عبر حقول البطاقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করুন যে আপনি আঙুল দিয়ে কার্ডের কোনো অংশ, বিশেষ করে নিচের দিকের লাইনগুলো ঢেকে ফেলছেন না। এছাড়াও কার্ডের উপর থাকা হলোগ্রামের প্রতিফলন যেন কার্ডের তথ্যের উপর না পড়ে, সেদিকেও খেয়াল রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že prstem nezakrýváte části karty, včetně spodních řádků. Dávejte si také pozor na hologramové odlesky, které přesahují pole karty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at du ikke dækker nogen dele af kortet med en finger, inklusive de nederste linjer. Vær desuden opmærksom på hologramrefleksioner, der går henover kortets felter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie auf Nummer sicher, indem Sie Teile der Karte nicht mit dem Finger verdecken, insbesondere nicht die unteren Zeilen. Vermeiden Sie außerdem Spiegelungen von Hologrammen, die über die Felder der Karte hinausgehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι δεν καλύπτετε μέρη της κάρτας με το δάχτυλό σας, συμπεριλαμβανομένων των κάτω γραμμών. Επίσης, προσέξτε τις αντανακλάσεις ολογράμματος που καλύπτουν τα πεδία της κάρτας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you aren’t covering parts of the card with a finger, including the bottom lines. Also, watch out for hologram reflections that go over the cards’ fields."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you’re not covering any part of the card with your fingers, including the bottom lines. Also watch out for hologram reflections that may obscure the card’s fields."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de que no está cubriendo partes de la tarjeta con el dedo, incluidas las líneas inferiores. Además, tenga cuidado con los reflejos de los hologramas que sobrepasan los campos de la tarjeta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de no tapar ninguna parte de la tarjeta con el dedo, incluidas las líneas inferiores. Además, tenga cuidado con los reflejos del holograma que se producen sobre los campos de la tarjeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطمئن شوید که قسمت‌هایی از کارت، از جمله خطوط پایینی، را با انگشت نمی‌پوشانید. همچنین، مراقب بازتاب‌های هولوگرام باشید که از روی زمینه کارت‌ها عبور می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, ettet peitä sormella mitään kortin osia, myöskään alarivejä. Varo myös kortin kenttien päälle tulevia hologrammien heijastuksia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguraduhing hindi natatakpan ng iyong daliri ang mga bahagi ng card, pati na ang mga linya sa ilalim. Gayon rin, tingnan kung may mga hologram reflection na tumatakip sa mga field ng mga card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veillez à ne pas recouvrir certaines parties de la carte avec un doigt, notamment les lignes de fond. Faites également attention aux reflets de l'hologramme qui recouvrent les champs de la carte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vous assurer de ne pas couvrir certaines parties de la carte avec votre doigt, y compris les lignes du bas. Veuillez également faire attention aux reflets holographiques qui peuvent apparaître sur les champs de la carte."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabbatar da cewa ba a rufe wasu ɓangarorin katin ba da yatsa, ciki har da layukan da suke ƙasan katin. Bayan haka, a duba ko akwai layukan haske da suka hau kan ɓangarorin katin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקפיד שלא לכסות חלקים מהמסמך באצבע, כולל השורות התחתונות.כמו כן, יש לשים לב להשתקפויות הולוגרמה העוברות על שדות הכרטיסים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान रखें कि आप अपनी उँगलियों से कार्ड के नीचे की रेखाओं सहित, किसी भी हिस्से को न ढकें. साथ ही, कार्ड के किनारों पर पड़ने वाले होलोग्राम प्रतिबिंबों पर भी ध्यान दें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripazite kako držite karticu. Nemojte prekrivati dijelove kartice prstom, uključujući donje linije. Također, pazite na refleksije holograma koje prelaze preko polja kartice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ügyeljen arra, hogy ne takarja le az ujjával a kártya részeit (az alsó sorokat is beleértve). Ügyeljen továbbá a hologramokra is, amelyek visszatükröződnek a kártya mezőin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan bagian kartu tidak tertutup jari, termasuk garis bawah. Perhatikan juga pantulan hologram yang melewati bidang kartu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gangið úr skugga um að þú sért ekki að hylja hluta spjaldsins með fingri, þar með talið neðri línurnar. Verið líka á varðbergi gagnvart endurkasti frá heilmynd sem fer yfir reiti kortanna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla di non stare coprendo parte della scheda, comprese le ultime righe, con un dito. Fai attenzione anche ai riflessi olografici situati sui campi della scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部の線も含め,カードの一部を指で覆わないようにしてください。また,カードの領域にかかるホログラムの反射にもご注意ください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "დარწმუნდით, რომ თითით ბარათის ნაწილებს არ ფარავთ, მათ შორის ქვედა ხაზებსაც. ასევე, ფრთხილად იყავით ჰოლოგრამულ ანარეკლებთანაც, რომლებიც ბარათის ველებზე გადადის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саусағыңызбен картаның кейбір бөліктерін, әсіресе төменгі жолдарын жауып қалмаңыз. Сондай-ақ, карта өрістерінің үстінен өтетін голограммалық шағылыстарға да назар аударыңыз."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ត្រូវប្រាកដថាអ្នកមិនគ្របដណ្តប់ផ្នែកនៃកាតដោយប្រើម្រាមដៃ រួមទាំងបន្ទាត់ខាងក្រោម។ ដូចគ្នានេះផងដែរ, ប្រយ័ត្នសម្រាប់ការឆ្លុះបញ្ចាំង hologram ដែលឆ្លងកាត់វាលរបស់សន្លឹកបៀ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락으로 카드의 일부, 특히 아래쪽 라인을 가리지 않도록 주의하세요. 또한, 카드의 정보 영역 위로 겹치는 홀로그램 반사에도 주의하세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārliecinieties, ka kādu kartes daļu, arī apakšējās līnijas, neaizsedzat ar pirkstu. Uzmanieties arī no kartes laukus šķērsojošās hologrammas atspulgiem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan anda tidak menutup sebahagian daripada kad dengan jari, termasuk baris bawah. Di samping itu, berhati-hati dengan pantulan hologram yang melintasi medan kad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at du ikke dekker til deler av kortet med en finger, inkludert bunnlinjene. Se også etter hologramrefleksjoner som kan forstyrre feltene på kortet."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "औँलाले कार्डको तल्लो लाइनहरू सहितको कुनै पनि भाग नछोप्नुहोस्। साथै, कार्डका विवरणहरूमा पर्न सक्ने होलोग्रामको चमकबाट पनि जोगिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat u onderdelen van de kaart niet afdekt met een vinger, dus ook niet de onderste regels. Waak ook voor hologramreflecties op de kaartvelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy nie zakrywasz palcem części karty, w tym dolnych linii. Uważaj również na odbicia holograficzne, które pojawiają się na polach kart."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "ډاډ حاصل کړئ چې د کارت برخې په ګوتو پټې نکړئ، د ښکته برخې د کرښو په ګډون. همدارنګه هولوګرام ته پام کوئ چې کېدای شي د کارت پر ځینو برخو راشي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que não cobre partes do cartão com um dedo, incluindo as linhas de baixo. Tenha também cuidado com os reflexos dos hologramas que cobrem os campos do cartão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de não cobrir partes do cartão com o dedo, incluindo as linhas inferiores. Além disso, fique atento a reflexos holográficos que ultrapassem os campos do cartão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigurați-vă că nu ați acoperit cu degetul porțiuni de pe card, nici rândurile de jos. Evitați și reflexiile holografice care se suprapun pe secțiunile din card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что вы не закрываете пальцем какие-либо части карты, включая нижние линии. Также обратите внимание на голографические отражения, которые могут попадать на поля карты."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඇඟිල්ලකින් කාඩ්පතේ පහළ ඇති රේඛා ඇතුළු කොටස් ආවරණය නොවන බවට වග බලා ගන්න. එසේම කාඩ්පතේ කොටස් මත ඇතිවන හොලෝග්‍රෑම් පරාවර්තන පිළිබඳව ද අවධානයෙන් සිටින්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že nezakrývate časti karty prstom, vrátane spodných čiar. Dávajte si tiež pozor na hologramové odrazy, ktoré prechádzajú cez polia kariet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepričajte se, da s prstom ne prekrivate delov kartice, vključno s spodnjimi vrsticami. Pazite tudi na hologramske odseve, ki segajo čez polja kartic."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uverite se da ne prekrivate delove kartice prstom, uključujući donje redove. Takođe, pazite na hologramske refleksije koje prelaze preko polja kartice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att du inte täcker delar av kortet med fingret, inklusive de nedre raderna. Se också upp för hologramreflektioner som löper över kortets fält."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha hujafunika sehemu za kadi kwa kidole, ikijumuisha laini za chini. Pia, kuwa mwangalifu na mwanga unaoakisiwa na hologramu unaopita juu ya sehemu za kadi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่านิ้วของคุณไม่ได้บังส่วนใดของบัตร รวมถึงบรรทัดล่างสุด นอกจากนี้ ระวังแสงสะท้อนของโฮโลแกรมที่จะทับส่วนต่างๆ ของบัตรด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt satırlar da dâhil olmak üzere, kartın hiçbir bölümünü parmağınla kapatmadığından emin ol. Ayrıca, kart alanlarının üzerini kapatan hologram yansımalarına da dikkat et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що ви не закриваєте частини картки пальцем, зокрема нижні рядки. Також стежте за відблисками від голограм, які перекривають поля картки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ آپ اپنی انگلی سے کارڈ کے کسی حصے کو، خاص طور پر نچلی سطروں کو ڈھانپ نہیں رہے۔ اس کے علاوہ ہولوگرام کے عکس سے بھی بچیں جو کارڈ کے خانوں پر پڑ سکتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barmogʻingiz kartaning ayrim qismlarini, jumladan, pastki qatorlarni berkitib qoʻymasin. Karta maydoni boʻylab oʻtadigan gologramma aks etishiga ham diqqat qarating."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo rằng bạn không dùng ngón tay che các phần của thẻ, kể cả các dòng dưới cùng. Ngoài ra, hãy để ý các phản xạ hình ba chiều đi qua các trường của thẻ."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Rí i dájú pé ọ kò fi ìka bo apá ibì kan lórí káàdì náà, títí kan àwọn ìlà ìsàlẹ̀. Bákan náà, ṣọ́ra fún àwọn ìtànyòò hologram tí wọ́n máa ń wa ní àwọn apá kan lórí káàdì náà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保您没有用手指遮盖卡的一部分，包括底部线条。此外，请留意卡的字段上的全息图反射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保您的手指沒有蓋到卡片的某些內容，包括底線。此外，請注意卡片欄位的全息圖反射。"
          }
        }
      }
    },
    "mb_blinkcard_help_screen_msg3": {
      "comment": "scan.help.harsh_light.card.message: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Mma kanea nhyerɛn wɔ kaade no so tee esiane sɛ ebetumi ama yenhu nsɛm a ɛwɔ so. Sɛ wuntumi nkenkan kaade no so nsɛm a, ɛrenna adi papa wɔ kamɛra no so nso."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካርዱ ላይ ስለሚያንፀባርቅ እና የካርዱን ክፍሎች እንዳይነበብ ስለሚያደርግ ቀጥተኛ ኃይለኛ ብርሃንን ያስወግዱ፣ በካርዱ ላይ ያለውን ውሂብ ማንበብ ካልቻሉ ለካሜራም የሚታይ አይሆንም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنب الضوء الشديد المباشر لأنه ينعكس من البطاقة وقد يجعل أجزاء من البطاقة غير قابلة للقراءة. إذا لم تتمكن من قراءة البيانات الموجودة على البطاقة، فلن تكون مرئية للكاميرا أيضاً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অত্যধিক তীব্র আলো ব্যবহার করা থেকে বিরত থাকুন, কারণ সেটি কার্ডে প্রতিফলিত হয়ে কিছু অংশ পড়া কঠিন করে তুলতে পারে। যদি আপনি নিজেই কার্ডের তথ্য পড়তে না পারেন, তাহলে ক্যামেরাও তা ধরতে পারবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhněte se přímému ostrému světlu, protože se odráží od karty a může způsobit, že její části nebudou čitelné. Pokud nelze údaje na kartě přečíst, nebudou viditelné ani pro fotoaparát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå direkte skarpt lys, da det reflekteres fra kortet og kan gøre dele af kortet ulæselige. Hvis du ikke kan læse dataene på kortet, vil de heller ikke være synlige for kameraet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meiden Sie direktes, grelles Licht, da dieses von der Karte reflektiert wird und so Teile der Karte unkenntlich machen kann. Wenn Sie keine Daten auf der Karte lesen können, sind diese auch für die Kamera nicht sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποφύγετε το άμεσο, έντονο φως, επειδή αντανακλάται από την κάρτα και μπορεί να κάνει ορισμένα μέρη της δυσανάγνωστα. Εάν δεν μπορείτε να διαβάσετε δεδομένα στην κάρτα, δεν θα είναι ορατά ούτε στην κάμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid direct harsh light because it reflects from the card and can make parts of the card unreadable. If you can’t read data on the card, it won’t be visible to the camera either."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid direct, harsh light as it can reflect off the card and make parts of it unreadable. If you can’t read the data on the card yourself, the camera won’t be able to either."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite la luz intensa directa porque se refleja en la tarjeta y puede hacer que algunas partes de la tarjeta sean ilegibles. Si no puede leer los datos de la tarjeta, tampoco serán visibles para la cámara."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite la luz directa intensa, ya que se refleja en la tarjeta y puede hacer que algunas partes de la misma resulten ilegibles. Si usted no puede leer los datos de la tarjeta, tampoco serán visibles para la cámara."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از نور مستقیم و شدید پرهیز کنید زیرا از کارت منعکس می‌شود و می‌تواند بخش‌هایی از کارت را غیرقابل خواندن کند. اگر نتوانید داده‌های روی کارت را بخوانید، برای دوربین نیز قابل مشاهده نخواهد بود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä suoraa voimakasta valoa, koska se heijastuu kortista ja voi tehdä osan kortista lukukelvottomaksi. Jos et pysty lukemaan kortin tietoja, ne eivät näy myöskään kameralle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwasan ang direktang nakakasilaw na ilaw dahil maaari itong mag-reflect sa card at hindi mababasa ang mga bahagi ng card. Kung mo mabasa ang data sa card, hindi rin ito makikita ng camera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez toute lumière directe et vive, car elle se reflète sur la carte et peut rendre certaines parties de la carte illisibles. Si les données ne sont pas lisibles sur la carte, elles ne le seront pas non plus pour la caméra."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez la lumière directe et intense, car elle se reflète sur la carte et peut rendre certaines parties illisibles. Si vous ne parvenez pas à lire les données sur la carte, elles ne seront pas non plus visibles pour la caméra."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada a yi amfani da haske mai ƙarfi domin zai yi dau a kan katin sannan zai sa ba za a iya karanta wasu ɓangarorin katin ba. Idan ba za ku iya karanta bayanan da suke kan katin ba, to kamara ma ba za ta iya ganin su ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הימנע מאור ישיר חזק מכיוון שהוא משתקף מהכרטיס ועלול להפוך חלקים מהכרטיס לבלתי קריאים. אם אינך יכול לקרוא את הנתונים בכרטיס, הם גם לא יהיו גלויים גם למצלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड पर सीधी और तेज़ रोशनी डालने से बचें क्योंकि यह कार्ड से परावर्तित होकर कार्ड के कुछ हिस्सों को न पढ़ सकने लायक बना सकती हैं. अगर आप कार्ड पर मौजूद डेटा को नहीं पढ़ पा रहे हैं, तो वह कैमरे को भी दिखाई नहीं देगा."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbjegavajte izravnu jaku svjetlost jer se reflektira s kartice i može učiniti dijelove kartice nečitljivima. Ako vi ne možete pročitati podatke na kartici, ni kamera ih neće moći vidjeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerülje a közvetlen, erős fényt, mivel visszaverődik a kártyáról, és ennek hatására a kártya egyes részei olvashatatlanná válhatnak. Ha nem tudja leolvasni a kártyán lévő adatokat, akkor a kamera számára sem lesznek láthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindari cahaya silau yang langsung karena memantul dari kartu dan akibatnya bagian kartu tidak terbaca. Jika Anda tidak dapat membaca data pada kartu, data juga tidak akan terlihat oleh kamera."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Forðist beint, skarpt ljós því það endurkastast frá kortinu og getur gert hluta kortsins ólæsilegan. Ef þú getur ekki lesið gögn á kortinu, þá verða þau heldur ekki sýnileg myndavélinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la luce intensa diretta, perché questa si riflette sulla scheda e può rendere illeggibili alcune sue parti. Se non riesci a leggere i dati sulla scheda, neanche la fotocamera potrà vederli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強い光を直接当てるとカードに反射してカードの一部が読み取れなくなる可能性があるため,避けてください。カードのデータを読み取れない場合,カメラにも認識されません。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "მოერიდეთ პირდაპირ მკვეთრ განათებას, რადგან ის ბარათზე ანარეკლს აჩენს და ბარათის ნაწილები შესაძლოა გარჩევადი აღარ იყოს. თუ ბარათზე მოცემულ მონაცემებს ვერ კითხულობთ, მას ვერც კამერა დააფიქსირებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тікелей және қатты жарықтан арырақ тұрыңыз, себебі ол картадан шағылысып, кейбір бөліктерін оқуға мүмкіндік бермейді. Егер картадағы деректер сізге көрінбесе, олар камераға да көрінбейді."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ជៀសវាងពន្លឺខ្លាំងដោយផ្ទាល់ ព្រោះវាឆ្លុះបញ្ចាំងពីកាត ហើយអាចធ្វើឱ្យផ្នែកខ្លះនៃកាតមិនអាចអានបាន។ ប្រសិនបើអ្នកមិនអាចអានទិន្នន័យនៅលើកាតបានទេ វាក៏មិនអាចមើលឃើញដោយកាមេរ៉ាដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드에 직접 강한 빛이 닿지 않도록 하세요. 빛이 반사되어 카드의 일부 정보가 읽히지 않을 수 있습니다. 카드에 있는 데이터를 육안으로 읽을 수 없다면, 카메라 역시 인식하지 못합니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvairieties no tiešas spilgtas gaismas, jo tā atstarojas no kartes un var padarīt atsevišķas kartes daļas nesalasāmas. Ja nevarat salasīt datus uz kartes, tos neredzēs arī kamera."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jauhi cahaya yang boleh menyilaukan mata kerana cahaya tersebut dipantulkan daripada kad dan boleh membuatkan sebahagian daripada kad tersebut tidak dapat dibaca. Jika anda tidak dapat membaca data dalam kad, data tersebut juga tidak akan kelihatan pada kamera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå direkte hardt lys fordi det gjenspeiles i kortet og kan føre til at deler av kortet blir uleselig. Hvis du ikke kan lese det som står på kortet, er det heller ikke synlig for kamera."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्डमा सीधै प्रकाश नपार्नुहोस्। चम्किलो प्रकाशले कार्डको विवरण पढ्न गाह्रो हुन्छ। तपाईंले पढ्न नसकेको कुनै पनि जानकारी क्यामेराले पनि चिन्न सक्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd direct fel licht, omdat dat vanaf de kaart weerspiegelt en delen van de kaart onleesbaar kan maken. Als u gegevens op de kaart niet kunt lezen, zijn ze voor de camera ook niet zichtbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj bezpośredniego, ostrego światła, ponieważ odbija się ono od karty i może uniemożliwić jej odczytanie. Jeśli nie możesz odczytać danych z karty, nie będą one również widoczne dla aparatu."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "مستقیم یې د څراغ وړانګو ته مه نیسئ ځکه چې وړانګې له کارت څخه منعکسې کېږي او د کارت ځینې برخې نه لوستل کېږي. که تاسو پر کارت موجود معلومات نشئ لوستلای، دا به د کامرې لپاره هم د لیدلو وړ نه وي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite luz direta intensa, pois reflete-se no cartão e pode deixar partes do mesmo ilegíveis. Se não consegue ler os dados no cartão, também não ficarão visíveis para a câmara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite luz forte e direta, pois ela reflete no cartão e pode tornar partes dele ilegíveis. Se você não conseguir ler os dados no cartão, eles também não serão visíveis para a câmera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitați lumina puternică directă, deoarece se va reflecta din card și poate face imposibilă citirea anumitor porțiuni din acesta. Dacă nu puteți citi datele de pe card, ele nu vor fi vizibile nici pe cameră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте прямого яркого света, так как он отражается от карты и может сделать некоторые её части нечитаемыми. Если вы не можете прочитать данные на карте, они не будут видны и камере."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඍජු රළු ආලෝකය කාඩ්පතේ වැදී පරාවර්තනය වී කාඩ්පතේ ඇති කොටස් කියවීමට නොහැකි විය හැකි බැවින් එය වළක්වා ගන්න. ඔබට කාඩ්පතේ දත්ත කියවිය නොහැකි නම්, එය කැමරාවට ද දෘශ්‍යමාන නොවේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhnite sa priamemu ostrému svetlu, pretože sa odráža od karty a môže spôsobiť, že časti karty budú nečitateľné. Ak vy nedokážete čítať údaje na karte, nebude ich vidieť ani kamera."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izogibajte se neposredni močni svetlobi, ker se ta odbija od kartice in lahko povzroči, da delov kartice ni mogoče prebrati. Če podatkov na kartici ne morete prebrati, jih tudi fotoaparat ne bo videl."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbegavajte direktnu oštru svetlost jer se odbija od kartice i može učiniti delove kartice nečitljivim. Ako ne možete da pročitate podatke na kartici, neće biti vidljivi ni kameri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik starkt direktljus eftersom det reflekteras från kortet och kan göra delar av det oläsliga. Om du inte kan läsa informationen på kortet kommer den inte heller att synas för kameran."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Epuka mwanga mkali wa moja kwa moja kwa sababu huakisiwa kutoka kwenye kadi na inaweza kufanya sehemu za kadi zisiweze kusomeka. Ikiwa huwezi kusoma data kwenye kadi, vilevile haitaonekana kwenye kamera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลีกเลี่ยงแสงจ้าที่ส่องตรงๆ เพราะแสงสะท้อนจากบัตรและบัตรอ่านไม่ออกบางส่วนได้ หากคุณอ่านข้อมูลบนบัตรไม่ได้ กล้องก็จะมองไม่เห็นเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan gelen sert ışık karttan yansıyarak kartın bazı kısımlarını okunmaz hâle getirebileceği için bu tür ışık kullanmaktan kaçın. Karttaki verileri okuyamıyorsan bu veriler kamerada da görünmeyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникайте прямого яскравого світла, адже воно відбивається від картки й може зробити частини картки нечитабельними. Якщо ви не можете прочитати дані на картці, камера їх також не зчитає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براہِ راست تیز روشنی سے پرہیز کریں کیونکہ یہ کارڈ پر عکس ڈالتی ہے اور اس کے کچھ حصے پڑھنے کے قابل نہیں رہتے۔ اگر آپ خود کارڈ پر موجود ڈیٹا نہیں پڑھ سکتے تو یہ کیمرے پر بھی نظر نہیں آئے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorqin yorugʻlik bevosita tushmasin, chunki u kartada aks etadi va kartaning ayrim qismlari tushunarsiz boʻlib qolishi mumkin. Karta maʼlumotlarini oʻqish imkoni boʻlmasa, ular kamerada ham koʻrinmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh ánh sáng gay gắt trực tiếp vì thẻ sẽ phản sáng và có thể làm cho các phần của thẻ không đọc được. Nếu bạn không thể đọc dữ liệu trên thẻ, thì dữ liệu đó cũng sẽ không hiển thị với camera."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Yẹra fún ìmọ́lẹ̀ tó lágbára nítorí pé ó máa ń hàn nínú káàdì náà àti pé ó lè mú kí àwọn apá kan káàdì náà má ṣe é kà. Tí ọ kò bá lè ka àwọn ìsọfúnni tó wà lórí káàdì náà, kò ní hàn sí kámẹ́rà náà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免直接强光，因为它会从卡上反射，并可能使卡的一些部分不可读。如果您无法阅读卡上的数据，摄像头也无法识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免直接刺眼的光線，因為光線會反射卡片，並且使卡片的某些內容無法讀取。如果您無法讀取卡片的內容，則相機也無法看清。"
          }
        }
      }
    },
    "mb_blinkcard_help_screen_msg4": {
      "comment": "scan.help.blur.card.message: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ sɛ wobɛma fon ne kaade no aka faako. Sɛ woma emu biara wosowosow a, mfonin no ani renna hɔ na wɔrenhu nsɛm a ɛwɔ kaade no so."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሚቃኙበት ጊዜ ስልኩን እና ካርዱን ጸንተው ይዘው ለማቆየት ይሞክሩ። አንዱን ማንቀሳቀስ ምስሉን ሊያደበዝዝ እና በካርዱ ላይ ያለውን ውሂብ የማይነበብ እንዲሆን ያደርገዋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول إبقاء الهاتف والبطاقة ثابتين أثناء المسح. يمكن أن يؤدي تحريك أي منهما إلى تعتيم الصورة وجعل البيانات الموجودة على البطاقة غير قابلة للقراءة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান করার সময় ফোন এবং কার্ড দুটোই স্থির রাখার চেষ্টা করুন। যেকোনো একটিকে নাড়ালে ছবি ঝাপসা হয়ে যেতে পারে এবং কার্ডের তথ্য পড়া অসম্ভব হয়ে যেতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při skenování se snažte držet telefon a kartu v klidu. Pohyb může obraz rozmazat a způsobit, že údaje na kartě nebudou čitelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv at holde telefonen og kortet stille, mens du scanner. Hvis du bevæger dig, kan billedet blive sløret og dataene på kortet blive ulæselige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie, das Telefon und die Karte während des Scanvorgangs ruhig zu halten. Jede Bewegung kann das Bild unscharf und die Daten auf der Karte unlesbar machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσπαθήστε να κρατήσετε το τηλέφωνο και την κάρτα ακίνητα κατά τη σάρωση. Η μετακίνηση οποιουδήποτε από τα δύο μπορεί να θολώσει την εικόνα και να καταστήσει τα δεδομένα στην κάρτα δυσανάγνωστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to keep the phone and card still while scanning. Moving either can blur the image and make data on the card unreadable."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the phone and card still while scanning. Moving either may blur the image and make the card details unreadable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intente mantener el teléfono y la tarjeta quietos mientras escanea. Mover cualquiera de los dos puede difuminar la imagen y hacer que los datos de la tarjeta sean ilegibles."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Intente mantener el teléfono y la tarjeta quietos mientras escanea. Si mueve cualquiera de los dos, la imagen puede salir borrosa y los datos de la tarjeta pueden resultar ilegibles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سعی کنید هنگام اسکن، گوشی و کارت را ثابت نگه دارید. حرکت دادن هر دو می‌تواند تصویر را تار کند و اطلاعات روی کارت را غیرقابل خواندن کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritä pitää puhelin ja kortti paikallaan skannauksen aikana. Jommankumman liikkuminen voi tehdä kuvasta epäselvän ja kortin tiedoista lukukelvottomia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihing hindi gumagalaw ang telepono at card habang nag-i-scan. Maaaring magpalabo sa larawan at hindi mababasa ang data sa card kapag nagalaw ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de garder le téléphone et la cartes immobiles pendant le scan. Tout mouvement de l'un ou l'autre peut brouiller l'image et rendre les données de la carte illisibles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de maintenir le téléphone et la carte immobiles pendant la numérisation. Tout mouvement peut rendre l'image floue et les données illisibles."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A daina motsa waya da kati yayin ɗaukar hoto. Motsa ɗaya daga cikinsu zai sa hoton ya yi dishi-dishi sannan zai sa ba za a iya karanta bayanan da suke kan katin ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסה לשמור על יציבות הטלפון והכרטיס בזמן הסריקה. הזזתם עלולה לטשטש את התמונה ולהפוך את הנתונים בכרטיס לבלתי קריאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन करते समय फ़ोन और कार्ड को स्थिर रखने का प्रयास करें. किसी भी एक को हिलाने से छवि धुंधली हो सकती है और कार्ड पर मौजूद डेटा पढ़ने योग्य नहीं रह सकता."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte za vrijeme skeniranja što mirnije držati telefon i karticu. Pomicanjem može doći do zamućenja slike zbog čega podaci postaju nečitljivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szkennelés során próbálja mozdulatlanul tartani a telefont és a kártyát. Mozgás hatására a kép elmosódhat, a kártyán lévő adatok pedig olvashatatlanná válhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usahakan ponsel dan kartu tetap diam saat memindai. Menggerakkan ponsel dapat mengaburkan gambar dan membuat data di kartu tidak dapat dibaca."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Reynið að halda símanum og kortinu kyrru meðan verið er að skanna. Ef annað hvort hreyfist getur myndin orðið óskýr og gögnin á kortinu orðið ólæsileg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca di tenere fermi il telefono e la scheda durante la scansione. Muoverli può rendere l'immagine sfocata e i dati sulla scheda illeggibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン中はスマートフォンとカードが動かないようにしてください。どちらかを動かすと画像が不鮮明になり,カードのデータを読み取れなくなる可能性があります。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "დასკანერებისას ეცადეთ არ გაამოძრაოთ ტელეფონი და ბარათი. გამოძრავების შემთხვევაში ფოტო შეიძლება დაიბუროს და ბარათზე ასახული მონაცემები გარჩევადი არ იყოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканерлеу кезінде телефон мен картаны мүмкіндігінше қозғалтпай ұстаңыз. Екеуінің де қозғалысы суретті бұлыңғыр етіп, картадағы деректерді оқылмайтындай етіп жіберуі мүмкін."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ព្យាយាមរក្សាទូរស័ព្ទ និងកាតឱ្យនៅស្ងៀមពេលកំពុងស្កេន។ ការផ្លាស់ទីទាំងពីរអាចធ្វើឱ្យរូបភាពព្រិល និងធ្វើឱ្យទិន្នន័យនៅលើកាតមិនអាចអានបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔하는 동안 휴대전화와 카드를 움직이지 않고 가만히 두세요. 둘 중 하나라도 움직이면 이미지가 흐려져 카드의 데이터가 읽히지 않을 수 있습니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenēšanas laikā nekustiniet tālruni un karti. Pretējā gadījumā attēls var būt izplūdis, un kartes dati var kļūt nesalasāmi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba kekalkan kedudukan telefon dan kad semasa mengimbas. Menggerakkan kedua-duanya boleh mengaburkan imej dan menjadikan data dalam kad tidak dapat dibaca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forsøk å holde telefonen og kortet i ro mens du skanner. Hvis de beveges, kan det føre til at bildet blir uskarpt og dataene i kortet blir uleselige."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया स्क्यान गर्दा फोन र कार्ड दुवैलाई नहल्लाई एकै ठाउँमा राख्नुहोस्। यी दुईमध्ये कुनै पनि हल्लिदा फोटो धमिलो हुन सक्छ र कार्डको जानकारी पढ्न गाह्रो हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer de telefoon en de kaart tijdens het scannen stil te houden. Als u een van beide beweegt, kan de afbeelding wazig worden en kunnen gegevens op de kaart onleesbaar worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staraj się trzymać telefon i kartę nieruchomo podczas skanowania. Poruszanie nimi może spowodować rozmycie obrazu i uniemożliwić odczytanie danych na karcie."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "هڅه وکړئ د سکن کولو پر مهال تلیفون او کارت ثابت ونیسئ. که یو یې و خوځول شي، انځور تیاره کېږي او پر کارت موجود معلومات نه لوستل کېږي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente manter o telefone e o cartão imóveis enquanto digitaliza. Mover algum deles pode desfocar a imagem e deixar os dados do cartão ilegíveis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente manter o telefone e o cartão imóveis durante o escaneamento. Mover qualquer um deles pode borrar a imagem e tornar os dados do cartão ilegíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați să mențineți telefonul și cardul imobile în timpul scanării. Mișcările pot compromite claritatea imaginii și pot face imposibilă citirea datelor de pe card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старайтесь держать телефон и карту неподвижно во время сканирования. Любое движение может размыть изображение и сделать данные на карте нечитаемыми."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ස්කෑන් කරන අතරතුර දුරකථනය සහ කාඩ්පත නොසෙල්වෙන සේ තබා ගන්න. මින් එකක් හෝ සෙලවීම රූපය අපැහැදිලි වී කාඩ්පතේ දත්ත කියවීමට නොහැකි වීමට හේතු විය හැක."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúste počas snímania ponechať telefón a kartu v pokoji bez pohybu. Pohyb môže rozmazať obraz a spôsobiť nečitateľnosť údajov na karte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med skeniranjem poskusite držati telefon in kartico pri miru. Gibanje obeh lahko zamegli sliko in onemogoči branje podatkov na kartici."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte da telefon i kartica budu mirni tokom skeniranja. Pomeranje bilo koje od njih može zamutiti sliku i učiniti podatke na dokumentu nečitljivim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök att hålla telefonen och kortet stilla under skanningen. Om du rör någotdera kan bilden bli suddig och informationen på kortet oläslig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaribu kuhakikisha kadi na simu havisongi unaposkani. Ukisogeza chochote picha inaweza kukosa kuonekana vizuri na kufanya data kwenye kadi isiweze kusomeka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามถือโทรศัพท์และวางบัตรไว้นิ่งๆ ขณะสแกน การเคลื่อนไหวอาจทำให้ภาพพร่ามัวและทำให้ข้อมูลบนบัตรอ่านไม่ออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama sırasında telefonu ve kartı sabit tutmaya çalış. Telefon veya kartın hareket etmesi görüntüyü bulanıklaştırabilir ve karttaki verileri okunmaz hâle getirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намагайтеся тримати телефон і картку нерухомо під час сканування. Рух одного з них може розмити зображення та зробити дані на картці нечитабельними."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکین کرتے وقت فون اور کارڈ کو ایک جگہ رکھنے کی کوشش کریں۔ کسی کو بھی ہلانے سے تصویر دھندلی ہو سکتی ہے اور کارڈ پر موجود ڈیٹا پڑھنے کے قابل نہیں رہتا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanerlaganda telefon va kartani qimirlatmang. Ulardan istalgan birining qimirlashi rasm xira olinishiga va karta maʼlumotlari tushunarsiz chiqishiga sabab boʻlishi mumkin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố gắng giữ yên điện thoại và thẻ trong khi quét. Di chuyển có thể làm mờ hình ảnh hoặc khiến dữ liệu trên thẻ không thể đọc được."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Gbìyànjú kó mú fóònù àti káàdì náà dúró nígbà ṣíṣe ẹ̀dà àwòrán. Sí sún kiri lè fa bóyá kí àwòrán náà rí bàìbàì àti kí ó mú kí àwọn ìsọfúnni orí káàdì náà má ṣe jẹ́ é kà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在扫描时尽量让手机和卡保持静止。移动任一项都可能让图像变模糊，使卡上的数据不可读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描時盡量保持手機及卡片穩定。任何移動都會使圖像模糊並造成卡片的內容無法讀取。"
          }
        }
      }
    },
    "mb_blinkcard_help_screen_title1": {
