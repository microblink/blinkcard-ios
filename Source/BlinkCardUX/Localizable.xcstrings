    "mb_blinkcard_onboarding_dialog_message": {
      "comment": "scan.onboarding.card.message: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Mpɛn pii no, kaade nɔma no taa yɛ digit 16, ɛwom sɛ ebetumi ayɛ efi digit 12 kosi 19 de. Etumi yɛ nea wɔaprinte agu so anaa wɔakurukyerɛw agu so ma aba soro. Hwɛ sɛ kanea a ɛfata da so na wotumi hu nsɛm a ɛwɔ so nyinaa."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የካርድ ቁጥር ብዙውን ጊዜ ባለ 16 አሃዝ ቁጥር ነው። በካርዱ ላይ ጎላ ባሉ ቁጥሮች መታተም ወይም መቀረጽ አለበት። ካርዱ በደንብ መብራቱን እና ሁሉም ዝርዝሮች የሚታዩ መሆናቸውን ያረጋግጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتكون رقم البطاقة عادةً من 16 رقماً. يجب أن يكون مطبوعاً أو منقوشاً بشكل بارز في البطاقة. تأكد من أن البطاقة موجودة في مكان جيد الإضاءة وأن جميع التفاصيل مرئية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড নম্বর সাধারণত 16-সংখ্যার একটি নম্বর হয়। এটি কার্ডের উপর উঁচু অক্ষরে ছাপানো বা খোদাই করা থাকে। নিশ্চিত করুন যে কার্ডটি ভালোভাবে আলোকিত এবং সব বিবরণ স্পষ্টভাবে দৃশ্যমান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo karty je obvykle 16místné. Mělo by být buď vytištěno, nebo vyraženo reliéfními číslicemi podél karty. Ujistěte se, že je karta dobře osvětlená a všechny údaje jsou viditelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortnummeret er normalt et 16-cifret nummer. Det skal enten være trykt eller præget med hævede tal på tværs af kortet. Sørg for, at kortet er godt oplyst, og at alle detaljer er synlige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartennummer besteht in der Regel aus einer 16-stelligen Zahl. Die Nummer sollte entweder aufgedruckt oder in erhabenen Ziffern auf der Karte eingeprägt sein. Versichern Sie sich, dass die Karte gut beleuchtet ist und alle Details sichtbar sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός της κάρτας είναι συνήθως 16ψήφιος. Θα αναγράφεται ή θα είναι χαραγμένος με ανάγλυφους αριθμούς πάνω στην κάρτα. Βεβαιωθείτε ότι η κάρτα είναι καλά φωτισμένη και όλα τα στοιχεία της είναι ορατά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card number is usually a 16-digit number. It should be either printed or embossed in raised numbers across the card. Make sure that the card is well lit and all details are visible."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The card number is usually 16 digits long. It will be printed or embossed in raised numbers on the card. Make sure the card is well lit and that all details are clearly visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de la tarjeta suele tener 16 dígitos. Debe estar impreso o grabado en relieve a lo largo de la tarjeta. Asegúrese de que la tarjeta esté bien iluminada y de que todos los datos sean visibles."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de la tarjeta suele ser un número de 16 dígitos. Debe estar impreso o grabado en relieve en la tarjeta. Asegúrese que la tarjeta esté bien iluminada y que todos los detalles sean visibles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شماره کارت معمولاً یک عدد ۱۶ رقمی است. این شماره باید یا چاپ شده باشد یا به صورت اعداد برجسته روی کارت حک شده باشد. مطمئن شوید که کارت به خوبی روشن است و تمام جزئیات آن قابل مشاهده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin numero sisältää tavallisesti 16 numeroa, ja sen tulisi olla painettuna tai kohokuvioituna korttiin. Varmista, että kortti on hyvin valaistu ja että kaikki tiedot ovat näkyvissä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadalasang 16 na digit ang numero ng card. Dapat itong naka-print o naka-emboss sa mga nakataas na numero sa buong card. Siguraduhing sapat na naiilawan ang card na iyon at nakikita ang lahat ng detalye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro de carte est généralement un numéro à 16 chiffres. En général, il est imprimé ou gravé en relief sur toute la surface de la carte. Assurez-vous que la carte est suffisamment éclairée et que tous les détails sont visibles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro de la carte est généralement un numéro à 16 chiffres. Il doit être imprimé ou gravé en relief sur la carte. Assurez-vous que la carte est bien éclairée et que tous les détails sont visibles."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yawanci lambar kati takan kasance lambobi 16. Za su kasance ko dai waɗanda aka gurza da rubutun kwamfuta ko waɗanda aka zana da tsarin rubutu mai tudu a kan katin. A tabbatar da cewa an haska katin yadda ya kamata sannan ana kallon dukkannin bayanan da suke kai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר הכרטיס הוא בדרך כלל באורך 16 ספרות. זה צריך להיות מודפס או מוטבע עם מספרים בולטים על פני הכרטיס. יש לוודא שהתאורה טובה וכל הפרטים גלויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड नंबर आमतौर पर 16 अंकों का होता है. इसे कार्ड पर उभरे हुए अंकों में या तो प्रिंट किया हुआ या उभरा हुआ होना चाहिए. सुनिश्चित करें कि कार्ड पर पर्याप्त रोशनी हो और सभी विवरण दिखाई दे रहे हों."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj kartice obično se sastoji od 16 znamenki i nalazi se otisnut ili urezan reljefnim brojkama na kartici. Provjerite je li kartica dobro osvijetljena i jesu li svi detalji jasno vidljivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyaszám általában 16 számjegyből áll. A szám nyomtatva vagy kiemelkedő, dombornyomott formában látható a kártyán. Ügyeljen a kártya megfelelő megvilágítására, és hogy minden adat jól látható legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor kartu biasanya berupa angka 16 digit. Nomor itu mestinya dicetak atau diembos dengan angka timbul di kartu. Pastikan kartu cukup terang dan semua detail terlihat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortanúmer er venjulega 16 stafa tala. Það ætti annaðhvort að vera prentað eða upphleypt í upphækkuðum tölum þvert yfir kortið. Gangið úr skugga um að kortið sé vel upplýst og að allar upplýsingar séu sýnilegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero della carta è in genere un numero di 16 cifre. Dovrebbe essere stampato o impresso in rilievo sulla carta. Assicurati che la carta sia ben illuminata e che tutti i dati siano visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード番号は通常,16桁の数字です。カード番号は,カードに印刷またはエンボス加工（浮き彫り）された数字として記載されています。カードが十分に明るく照らされ,すべての詳細が視認できるようにしてください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარათის ნომერი, როგორც წესი, 16 ციფრისგან შედგება. ეს ნომერი ან დაბეჭდილი უნდა იყოს, ან ამოტვიფრული ამობურცული ციფრებით ბარათზე. დარწმუნდით, რომ ბარათი კარგადაა განათებული და ყველა დეტალი ჩანს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта нөмірі әдетте 16 таңбалы саннан тұрады. Ол басып шығарылуы немесе карта бойынша жоғары сандармен бедерлі болуы керек. Картаның жақсы жарық бар жерде орналасқанына және барлық мәліметтер көрінетініне көз жеткізіңіз."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "លេខកាតជាធម្មតាជាលេខ 16 ខ្ទង់។ វាគួរតែត្រូវបានបោះពុម្ព ឬក្រឡោតជាលេខដែលបានលើកឡើងនៅទូទាំងកាត។ ត្រូវប្រាកដថាកាតមានពន្លឺល្អ ហើយព័ត៌មានលម្អិតទាំងអស់អាចមើលឃើញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 번호는 일반적으로 16자리 숫자입니다. 카드에 인쇄되어 있거나, 양각으로 돌출된 숫자로 표시되어 있습니다. 카드가 잘 보이도록 조명을 밝게 하고, 모든 세부 정보가 보이는지 확인하세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parasti kartes numuru veido 16 cipari. Tam jābūt uzdrukātam vai reljefi iespiestam pār karti. Pārliecinieties, ka apgaismojums ir pietiekams un visa kartes informācija ir labi redzama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor kad biasanya mempunyai nombor 16 digit. Ia hendaklah sama ada dicetak atau dicetak timbul dengan nombor berganda di sepanjang kad. Pastikan kad tersebut menerima pencahayaan yang cukup dan semua butiran dapat dilihat dengan jelas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortnummeret er vanligvis et nummer på 16 siffer. Det skal enten være trykt eller preget i opphøyde tall på kortet. Sørg for at kortet er godt opplyst og at alle detaljene er synlige."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड नम्बर सामान्यतया 16 अंकको हुन्छ। यो नम्बर कार्डमा माथि उठेका अक्षरमा इम्बोस्ड गरिएको वा छापिएको हुन्छ। कार्डलाई राम्ररी उज्यालोमा राख्नुहोस् र सबै विवरणहरू प्रष्ट देखाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kaartnummer bestaat in de regel uit 16 cijfers. Het nummer is ofwel gedrukt of in reliëf in verhoogde cijfers op de kaart aangebracht. Zorg ervoor dat de kaart goed wordt verlicht en dat alle details zichtbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numer karty to zazwyczaj numer składający się z 16 cyfr. Powinien być wydrukowany lub wytłoczony wypukłymi cyframi na karcie. Upewnij się, że karta jest dobrze oświetlona i wszystkie szczegóły są widoczne."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "د کارت شمېره معموله 16 عدده وي. دا باید په چاپي یا برجسته توګه پر کارت لیکل شوې وي. ډاډمن کړئ چې کارت ښه روښانه دی او ټول جزئیات یې د لیدلو وړ دي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O número do cartão geralmente é um número de 16 dígitos. Deverá estar impresso ou gravado com relevo no cartão. Garanta que o cartão fique bem iluminado e que todos os detalhes estejam visíveis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número do cartão geralmente tem 16 dígitos. Ele deve estar impresso ou gravado em alto relevo em todo o cartão. Certifique-se de que o cartão esteja bem iluminado e que todos os detalhes estejam visíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul cardului conține de regulă 16 cifre. În principiu, acesta este inscripționat sau reliefat pe card. Asigurați-vă că este bine iluminat cardul și că toate detaliile sunt vizibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер карты обычно состоит из 16 цифр. Он должен быть напечатан или выдавлен рельефными цифрами по всей карте. Убедитесь, что карта хорошо освещена и все детали видны."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කාඩ්පත් අංකය සාමාන්‍යයෙන් ඉලක්කම් 16කින් යුත් අංකයකි. එය කාඩ්පත මත මුද්‍රණය කර ඇති හෝ පිටතට නෙරා ගිය ලෙස කැටයම් කළ අංකයකි. කාඩ්පතට හොඳින් ආලෝකය වැටී එහි සියලු විස්තර හොඳින් පෙනෙන බවට සහතික කර ගන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo karty je zvyčajne 16-miestne číslo. Malo by byť vytlačené alebo vyrazené vo forme vyvýšených čísel naprieč kartou. Uistite sa, že karta je dobre osvetlená a všetky detaily sú viditeľné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Številka kartice je običajno 16-mestna. Natisnjena ali vtisnjena mora biti z dvignjenimi številkami po celotni kartici. Prepričajte se, da je kartica dobro osvetljena in da so vidne vse podrobnosti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj kartice je obično 16-cifreni broj. Trebalo bi da bude odštampan ili utisnut podignutim brojevima preko kartice. Uverite se da je kartica dobro osvetljena i da su svi detalji vidljivi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortnumret består oftast av 16 siffror. Det är antingen tryckt eller präglat i upphöjda siffror på kortets fram- eller baksida. Se till att kortet är ordentligt upplyst och att alla detaljer syns."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Namba ya kadi kawaida ni namba 16. Inapaswa kuwa imechapishwa au kuchorwa kwa namba zilizoinuka kwenye kadi. Hakikisha kadi iko kwenye mwanga wa kutosha na maelezo yote yanaonekana."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขบัตรมักจะเป็นตัวเลข 16 หลัก อาจเป็นตัวเลขพิมพ์หรือปั๊มนูนพาดอยู่บนบัตร ตรวจสอบให้แน่ใจว่ามีแสงสว่างที่บัตรเพียงพอและเห็นรายละเอียดทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart numarası, genellikle 16 haneli bir sayıdır. Kartın üzerinde kabartmalı rakamlarla basılı veya kabartmalı olmalıdır. Kartın iyi aydınlatılmış ve tüm bilgilerin görünür olduğundan emin ol."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер картки — це зазвичай 16-значне число. Він має бути надрукований або вибитий у вигляді рельєфних цифр по всій картці. Переконайтеся, що картка добре освітлена і на ній видно всі деталі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ نمبر عموماً 16 ہندسوں پر مشتمل ہوتا ہے۔ یہ یا تو پرنٹ کیا ہوا ہوتا ہے یا ابھری ہوئی شکل میں کارڈ پر درج ہوتا ہے۔ یہ یقینی بنائیں کہ کارڈ پر مناسب روشنی ہے اور تمام تفصیلات صاف نظر آ رہی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta raqami odatda 16 ta raqamdan iborat. U kartada bosma yoki boʻrtma shaklda tushirilgan boʻlishi kerak. Skanerlaganda yorugʻlik yetarlicha boʻlsin va barcha tafsilotlari koʻrinsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số thẻ thường là một số gồm 16 chữ số. Các số đó phải được in hoặc dập nổi bằng các số nổi trên thẻ. Đảm bảo rằng thẻ được chiếu sáng tốt và tất cả các chi tiết đều có thể nhìn thấy được."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Nọ́mbà káàdì sábà máa ń jẹ́ dígítì 16. Ó gbọdọ̀ wà ní àtẹ̀jáde tàbí kí wọ́n fín ní gbọọrọ sórí káàdì náà ní àwọn nọ́mbà tí ọwọ́ lè rí. Ríi dájú pé ìmọ́lẹ̀ tàn sí káàdì náà dáadáa àti kí gbogbo ìsọfúnni ara rẹ̀ hàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡号通常是 16 位数。卡号应该是卡中打印或凸印的数字。确保卡的光照良好，所有细节清晰可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡號通常為 16 位數字。應該在卡片上以凸起數字印刷或雕刻。確保卡片光線充足並且所有內容都很清楚。"
          }
        }
      }
    },
    "mb_blinkcard_onboarding_dialog_title": {
      "comment": "scan.onboarding.card.title: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kan skaane kaade nɔma no"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መጀመሪያ የካርድ ቁጥሩን ይቃኙ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رقم البطاقة أولاً"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে কার্ড নম্বর স্ক্যান করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve naskenujte číslo karty"
          }
        },
        "da": {
