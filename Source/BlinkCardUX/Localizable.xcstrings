        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úspech! Strana s číslom karty bola naskenovaná"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspelo! Stran s številko kartice je skenirana"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspešno! Strana sa brojem kartice je skenirana"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyckades! Kortets nummersida skannat"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imemaliza! Upande wa namba ya kadi umeskaniwa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนบัตรด้านที่มีหมายเลขสำเร็จ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarılı! Kart numarasının bulunduğu taraf tarandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Успіх! Номер картки відскановано"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کامیابی! کارڈ نمبر والی سائیڈ اسکین ہو گئی ہے"
