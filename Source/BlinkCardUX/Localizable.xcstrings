            "value": "කාඩ්පතේ අංකය ස්කෑන් කරන්න"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasnímajte číslo karty"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte številko kartice"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte broj kartice"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna kortnumret"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Skani namba ya kadi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนหมายเลขบัตร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart numarasını tara"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте номер картки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ نمبر کو اسکین کریں"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta raqamini skanerlang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét số thẻ"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ṣe ẹ̀dà àwòrán nọ́mbà káàdì náà"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描卡号"
          }
        },
        "zh-Hant": {
