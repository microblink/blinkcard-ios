    "mb_blinkcard_recognition_timeout_dialog_message": {
      "comment": "scan.error.unsuccessful.message.card: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ sɛ kaad no nya hann yiye, wohu no nyinaa, na hann mmɔ ani wɔ so."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካርዱ በደንብ የበራ፣ ሙሉ በሙሉ የሚታይ እና ነጸብራቅ የሌለበት መሆኑን ያረጋግጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن البطاقة مضاءة جيدًا، ومرئية بالكامل، وخالية من الوهج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করুন যে কার্ডটিতে পর্যাপ্ত আলো রয়েছে, সেটি সম্পূর্ণ দৃশ্যমান এবং তাতে আলোর প্রতিফলন নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že je karta dobře osvětlená, celá viditelná a bez odlesků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at kortet er godt oplyst, helt synligt og uden genskin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass die Karte gut beleuchtet, vollständig sichtbar und frei von Reflexionen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι η κάρτα φωτίζεται καλά, είναι πλήρως ορατή και δεν έχει αντανακλάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the card is well lit, fully visible, and free of glare."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the card is well lit, fully visible and free of glare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la tarjeta esté bien iluminada, sea totalmente visible y no tenga reflejos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la tarjeta esté bien iluminada, completamente visible y sin reflejos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Motma'en shavid kârt khub roshan, kâmel namâyân va bedûn-e tâbesh ast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että kortti on hyvin valaistu, kokonaan näkyvissä eikä siinä ole heijastuksia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiyaking may sapat na liwanag, ganap na nakikita, at walang silaw ang card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que la carte est bien éclairée, entièrement visible et sans reflets."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que la carte est bien éclairée, entièrement visible et sans reflets."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbatar cewa katin yana da isasshen haske, yana bayyane gaba ɗaya, kuma babu kyallin haske a kansa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ודאו שהכרטיס מואר היטב, גלוי במלואו וללא השתקפויות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि कार्ड पर पर्याप्त रोशनी हो, वह पूरी तरह दिखाई दे रहा हो और उस पर चमक न हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripazite da je kartica dobro osvijetljena, u potpunosti vidljiva i bez odsjaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Győződjön meg arról, hogy a kártya jól megvilágított, teljesen látható és tükröződésmentes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan kartu mendapat pencahayaan yang baik, terlihat sepenuhnya, dan bebas dari pantulan cahaya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gakktu úr skugga um að kortið sé vel upplýst, sjáist að fullu og sé glampalaust."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che la carta sia ben illuminata, completamente visibile e senza riflessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード全体が表示され、十分に明るく、反射がないことを確認してください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "დარწმუნდით, რომ ბარათი კარგად არის განათებული, სრულად ჩანს და არ ირეკლავს სინათლეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картаның жақсы жарықтандырылғанына, толық көрінетініне және онда шағылыс жоқ екеніне көз жеткізіңіз."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមប្រាកដថាកាតមានពន្លឺគ្រប់គ្រាន់ អាចមើលឃើញទាំងស្រុង និងគ្មានពន្លឺចាំង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드에 빛이 충분히 비치고, 카드 전체가 보이며, 빛 반사가 없는지 확인하세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārliecinieties, vai karte ir labi apgaismota, pilnībā redzama un bez atspīdumiem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan kad diterangi dengan baik, kelihatan sepenuhnya dan bebas daripada silau."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at kortet er godt opplyst, fullt synlig og uten gjenskinn."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्डमा पर्याप्त प्रकाश परेको, पूर्ण रूपमा देखिएको र चमक नभएको सुनिश्चित गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat de kaart goed verlicht, volledig zichtbaar en vrij van schittering is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że karta jest dobrze oświetlona, w całości widoczna i bez odblasków."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "ډاډ ترلاسه کړئ چې کارت ښه روښانه، بشپړ ښکاره او له ځلا پاک دی."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que o cartão está bem iluminado, totalmente visível e sem reflexos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o cartão está bem iluminado, totalmente visível e sem reflexos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigurați-vă că cardul este bine iluminat, complet vizibil și fără reflexii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что карта хорошо освещена, полностью видна и на ней нет бликов."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කාඩ්පතට හොඳ ආලෝකයක් ඇති බවත්, එය සම්පූර්ණයෙන් පෙනෙන බවත්, දිලිසීමක් නොමැති බවත් තහවුරු කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že karta je dobre osvetlená, celá viditeľná a bez odleskov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskrbite, da je kartica dobro osvetljena, v celoti vidna in brez odsevov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proverite da li je kartica dobro osvetljena, potpuno vidljiva i bez odsjaja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att kortet är väl upplyst, syns helt och är fritt från reflexer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha kadi ina mwanga wa kutosha, kadi yote inaonekana, na haina mng'ao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่าบัตรมีแสงสว่างเพียงพอ มองเห็นได้ครบทั้งใบ และไม่มีแสงสะท้อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartın iyi aydınlatıldığından, tamamen görünür olduğundan ve yansıma olmadığından emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що картка добре освітлена, повністю видима та без відблисків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ کارڈ اچھی طرح روشن ہو، مکمل طور پر نظر آ رہا ہو اور اس پر چمک نہ ہو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta yaxshi yoritilgan, to‘liq ko‘rinib turgan va yaltirashsiz ekaniga ishonch hosil qiling."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo thẻ đủ sáng, hiển thị đầy đủ và không bị chói."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Rí i dájú pé káàdì náà ní ìmọ́lẹ̀ tó, hàn pátápátá, kò sì ní ìtànṣán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保卡片光线充足、完全可见且无反光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認卡片有充足光線、完整可見且沒有反光。"
          }
        }
      }
    },
