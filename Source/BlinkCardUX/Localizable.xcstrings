            "value": "카드 번호 면 스캔 완료!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartes numura puse noskenēta veiksmīgi!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjaya! Sebelah nombor kad diimbas"
