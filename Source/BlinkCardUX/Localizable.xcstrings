{
  "sourceLanguage": "en",
  "strings": {
    "mb_accessibility_success_card_number_side_scanned": {
      "comment": "scan.card_number_scanned: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayɛ yie! Kaade nɔma fa no askaane"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተሳክቷል! የካርድ ቁጥር ጎኑ ተቃኝቷል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بنجاح! تم مسح رقم البطاقة ضوئياً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সফল! কার্ডের নম্বর সাইড স্ক্যান হয়েছে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úspěch! Strana s číslem karty byla naskenována"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lykkedes! Siden med kortnummeret er scannet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolg! Nummernseite der Karte gescannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτυχής σάρωση της πλευράς της κάρτας με τον αριθμό!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Success! Card number side scanned"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Success! Card number side scanned"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Perfecto! Lado con el número de la tarjeta escaneado"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Éxito! Se escaneó el número de la tarjeta"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با موفقیت انجام شد! شماره کارت اسکن شد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onnistui! Kortin numeropuoli on skannattu"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagumpay! Na-scan ang numero na bahagi ng card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numéro de carte scanné au verso avec succès !"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Réussite ! Côté du numéro de la carte numérisé"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An yi nasara! An ɗauki hoton gefen lambar kati"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצלחנו! חזית הכרטיס נסרקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफलता! कार्ड नंबर साइड स्कैन हो गया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspjeh! Strana s brojem kartice skenirana"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikerült! A kártyaszámos oldal beszkennelve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhasil! Sisi nomor kartu sudah dipindai"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tókst! Kortnúmerhlið skönnuð"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfetto! Lato con numero carta scansionato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成功！カード番号のある面をスキャンしました"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "წარმატებული! ბარათის ნომრის მხარე დასკანერებულია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сәтті! Карта нөмірлері жағы сканерленді"
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ជោគជ័យ! បានស្កេនផ្នែកខាងលេខកាត"
