        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucesso! Número do cartão digitalizado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Número do cartão escaneado com sucesso"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Succes! Fața cu numărul cardului scanată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово! Сторона карты с номером отсканирована"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සාර්ථකයි! කාඩ්පතේ අංකය ඇති පැත්ත ස්කෑන් කර ඇත"
